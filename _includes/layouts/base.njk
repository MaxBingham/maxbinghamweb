<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<script eleventy:ignore>
			try {
				var __t = localStorage.getItem("theme");
				if (__t === "dark" || __t === "light") document.documentElement.setAttribute("data-theme", __t);
			} catch (e) {}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and page.url != "/" %}{{ title }} — {{ metadata.title }}{% else %}{{ metadata.title }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="generator" content="{{ eleventy.generator }}">
		<meta name="color-scheme" content="dark light">

		<style>{% include "node_modules/simpledotcss/simple.min.css" %}</style>
		<style>{% include "css/custom.css" %}</style>
		<link rel="stylesheet" href="{% getBundleFileUrl "css" %}">

		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Home">
				<span class="wordmark-name">Max Bingham</span>
				<span class="wordmark-dot" aria-hidden="true">·</span>
				<span class="wordmark-sub">creative space</span>
			</a>
			<div class="site-header-end">
				<nav aria-label="Primary">
					<ul class="nav">
					{%- for entry in collections.all | eleventyNavigation %}
						{%- if entry.key != "Home" %}
						<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
						{%- endif %}
					{%- endfor %}
					</ul>
				</nav>
				<div class="social-icons" aria-label="Social links">
					<a class="social-icon" href="https://github.com/MaxBingham" rel="me" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.87 8.17 6.84 9.5.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34-.46-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.6.07-.6 1 .07 1.53 1.03 1.53 1.03.87 1.52 2.34 1.07 2.91.83.09-.65.35-1.09.63-1.34-2.22-.25-4.55-1.11-4.55-4.94 0-1.1.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.56 9.56 0 0112 6.8c.85.004 1.7.114 2.5.34 1.9-1.29 2.75-1.02 2.75-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.85v2.74c0 .27.16.59.67.5A10.003 10.003 0 0022 12c0-5.523-4.477-10-10-10z"/></svg>
					</a>
					<a class="social-icon" href="https://www.linkedin.com/in/mjbinghamnikol" rel="me" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
					</a>
					<a class="social-icon" href="mailto:max.bingham-nikol@tum.de" aria-label="Email">
						<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/></svg>
					</a>
				</div>
				<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" aria-pressed="true">
					<svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg>
					<svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg>
				</button>
			</div>
		</header>

		{% if page.url != "/" %}
		<div class="page-title">
			<h1>{%- if title %}{{ title }}{%- else %}{{ metadata.title }}{%- endif %}</h1>
			{% if description %}<p class="page-description">{{ description }}</p>{% endif %}
		</div>
		{% endif %}

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer class="site-footer">
			<p>
				<a href="/">Home</a> ·
				<a href="/works/">Work</a> ·
				<a href="/cv/">CV</a> ·
				<a href="/visuals/">Visuals</a> ·
				<a href="/thoughts/">Thoughts</a> ·
				<a href="/feed/feed.xml">Atom</a>
			</p>
			<p>
				<a href="https://github.com/MaxBingham" rel="me">GitHub</a> ·
				<a href="https://www.linkedin.com/in/mjbinghamnikol" rel="me">LinkedIn</a> ·
				<a href="mailto:max.bingham-nikol@tum.de">Email</a>
			</p>
			<p class="muted"><a href="https://github.com/MaxBingham/maxbinghamweb">Source</a></p>
		</footer>

		<script defer src="/js/theme-toggle.js"></script>
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
