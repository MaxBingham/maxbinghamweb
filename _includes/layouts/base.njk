<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and page.url != "/" %}{{ title }} — {{ metadata.title }}{% else %}{{ metadata.title }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="generator" content="{{ eleventy.generator }}">
		<meta name="theme-color" content="#f5f3ee">

		<style>{% include "node_modules/simpledotcss/simple.min.css" %}</style>
		<style>{% include "css/custom.css" %}</style>
		<link rel="stylesheet" href="{% getBundleFileUrl "css" %}">

		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Max Bingham Nikol, home">
				<span class="wordmark-mark" aria-hidden="true">MBN</span>
				<span class="wordmark-name">Max Bingham Nikol</span>
			</a>
			<nav class="site-nav" aria-label="Primary">
				<a href="/cv/">CV</a>
				<a href="https://github.com/MaxBingham" rel="me">GitHub</a>
				<a href="https://www.linkedin.com/in/mjbinghamnikol" rel="me">LinkedIn</a>
				<a href="mailto:max.bingham-nikol@tum.de" aria-label="Email Max">Email</a>
			</nav>
		</header>

		{% if page.url != "/" and page.url != "/404.html" %}
		<div class="page-title">
			<h1>{%- if title %}{{ title }}{%- else %}{{ metadata.title }}{%- endif %}</h1>
			{% if description %}<p class="page-description">{{ description }}</p>{% endif %}
		</div>
		{% endif %}

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer class="site-footer">
			<p>Max Bingham Nikol <span aria-hidden="true">·</span> German–American engineer</p>
			<nav aria-label="Secondary">
				<a href="/photos/">Photos</a>
				<a href="/blog/">Notes</a>
				<a href="/feed/feed.xml">RSS</a>
				<a href="https://github.com/MaxBingham/maxbinghamweb">Source</a>
			</nav>
		</footer>

		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
