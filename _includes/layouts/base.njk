<!doctype html>
<html lang="{{ metadata.language }}">
	<head>
		<meta charset="utf-8">
		<script eleventy:ignore>
			try {
				var __t = localStorage.getItem("theme");
				if (__t === "dark" || __t === "light") document.documentElement.setAttribute("data-theme", __t);
			} catch (e) {}
		</script>
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>{% if title and page.url != "/" %}{{ title }} — {{ metadata.title }}{% else %}{{ metadata.title }}{% endif %}</title>
		<meta name="description" content="{{ description or metadata.description }}">
		<link rel="alternate" href="/feed/feed.xml" type="application/atom+xml" title="{{ metadata.title }}">
		<meta name="generator" content="{{ eleventy.generator }}">
		<meta name="color-scheme" content="dark light">

		<style>{% include "node_modules/simpledotcss/simple.min.css" %}</style>
		<style>{% include "css/custom.css" %}</style>
		<link rel="stylesheet" href="{% getBundleFileUrl "css" %}">

		<script type="module">{% include "node_modules/@zachleat/heading-anchors/heading-anchors.js" %}</script>
	</head>
	<body>
		<header class="site-header">
			<a class="wordmark" href="/" aria-label="Home">
				<span class="wordmark-name">Max Bingham</span>
				<span class="wordmark-dot" aria-hidden="true">·</span>
				<span class="wordmark-sub">creative space</span>
			</a>
			<div class="site-header-end">
				<nav aria-label="Primary">
					<ul class="nav">
					{%- for entry in collections.all | eleventyNavigation %}
						{%- if entry.key != "Home" %}
						<li class="nav-item"><a href="{{ entry.url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
						{%- endif %}
					{%- endfor %}
					</ul>
				</nav>
				<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle theme" aria-pressed="true">
					<svg class="theme-icon theme-icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"></path></svg>
					<svg class="theme-icon theme-icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"></path></svg>
				</button>
			</div>
		</header>

		{% if page.url != "/" %}
		<div class="page-title">
			<h1>{%- if title %}{{ title }}{%- else %}{{ metadata.title }}{%- endif %}</h1>
			{% if description %}<p class="page-description">{{ description }}</p>{% endif %}
		</div>
		{% endif %}

		<main id="main">
			<heading-anchors>
				{{ content | safe }}
			</heading-anchors>
		</main>

		<footer class="site-footer">
			<p>
				<a href="/">Home</a> ·
				<a href="/works/">Work</a> ·
				<a href="/cv/">CV</a> ·
				<a href="/visuals/">Visuals</a> ·
				<a href="/reads/">Reads</a> ·
				<a href="/thoughts/">Thoughts</a> ·
				<a href="/feed/feed.xml">Atom</a>
			</p>
			<p>
				<a href="https://github.com/MaxBingham" rel="me">GitHub</a> ·
				<a href="https://www.linkedin.com/in/mjbinghamnikol" rel="me">LinkedIn</a> ·
				<a href="mailto:max.bingham-nikol@tum.de">Email</a>
			</p>
			<p class="muted"><a href="https://github.com/MaxBingham/maxbinghamweb">Source</a></p>
		</footer>

		<script defer src="/js/theme-toggle.js"></script>
		<script type="module" src="{% getBundleFileUrl "js" %}"></script>
	</body>
</html>
